# Antigravity Local LLM & Hybrid Agent Environment Configuration

# Local Project Workspace folder(s) to include for agent tools (view_file, edit_file, run_command)
# You can add multiple lines or comma-separated paths; they will all appear in the GUI dropdown selector!
ANTIGRAVITY_WORKSPACE=F:\Personal
ANTIGRAVITY_WORKSPACE=F:\Code

# Local Inference Endpoint (LM Studio server running on port 1234)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=qwen2.5-7b-instruct-1m

# Cloud Model for strategic planning & fallback
CLOUD_MODEL=gemini-2.5-flash
